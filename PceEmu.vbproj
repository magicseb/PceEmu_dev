<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PceEmu</RootNamespace>
    <AssemblyName>PceEmu</AssemblyName>
    <StartupObject>PceEmu.Program</StartupObject>
    <ApplicationIcon>ico\PceEmu.ico</ApplicationIcon>
    <OptionStrict>Off</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <!-- Performance : désactive les vérifications d'overflow (boucle CPU chaude) -->
    <RemoveIntegerChecks>true</RemoveIntegerChecks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Décodage 7z ; le ZIP passe par la bibliothèque standard -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icône embarquée (chargée dans Me.Icon pour la fenêtre / barre des tâches) -->
    <EmbeddedResource Include="ico\PceEmu.ico">
      <LogicalName>PceEmu.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Les bancs d'essai ont leur propre projet et leur propre point d'entrée -->
    <Compile Remove="Tests/**" />
  </ItemGroup>

</Project>
